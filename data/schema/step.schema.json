{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Một bước mô phỏng",
  "type": "object",
  "required": [
    "compare",
    "swap",
    "done",
    "vars",
    "line",
    "explain"
  ],
  "oneOf": [
    {
      "required": [
        "array"
      ]
    },
    {
      "required": [
        "grid"
      ]
    }
  ],
  "properties": {
    "array": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "grid": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "compare": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      ]
    },
    "swap": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      ]
    },
    "done": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      ]
    },
    "ptr": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "vars": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "line": {
      "type": "integer",
      "minimum": -1
    },
    "explain": {
      "type": "string",
      "minLength": 1
    },
    "cmp": {
      "type": "integer",
      "minimum": 0
    },
    "sw": {
      "type": "integer",
      "minimum": 0
    },
    "anim": {
      "enum": [
        "swap",
        null
      ]
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  }
}
