{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bảng thuật ngữ Việt – Anh",
  "type": "object",
  "required": [
    "terms"
  ],
  "properties": {
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "vi",
          "en",
          "definition",
          "modules"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "vi": {
            "type": "string"
          },
          "en": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
